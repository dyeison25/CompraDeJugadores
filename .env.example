# Copia este archivo a .env y completa los valores solo en tu equipo.
DATABASE_BACKEND=postgresql
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST.neon.tech/BASE?sslmode=require
# Genera una clave propia para el despliegue.
SECRET_KEY=
COOKIE_SECURE=0
# En Render gratuito: 0 para utilizar solo fotos por URL HTTPS.
ALLOW_UPLOADS=1
